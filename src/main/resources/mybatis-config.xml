<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>

    <!-- 驼峰映射：数据库 user_name 自动映射到属性 userName（★ 强烈建议开启） -->
    <settings>
        <setting name="mapUnderscoreToCamelCase" value="true"/>
        <!-- 控制台打印 SQL（学习/调试神器） -->
        <setting name="logImpl" value="STDOUT_LOGGING"/>
    </settings>

    <!-- 环境：一个环境 = 一套数据源 + 事务管理器 -->
    <environments default="dev">
        <environment id="dev">
            <!-- JDBC 事务管理器：commit/rollback 手动控制 -->
            <transactionManager type="JDBC"/>
            <!-- 数据源：MyBatis 自带连接池 -->
            <!-- type 必须是 DataSourceFactory 实现：直接写 HikariDataSource 会 ClassCastException -->
            <dataSource type="com.wyy.utils.HikariDataSourceFactory">
                <property name="driver" value="com.mysql.cj.jdbc.Driver"/>
                <property name="url" value="jdbc:mysql://localhost:3306/rbac?useSSL=false&amp;serverTimezone=Asia/Shanghai"/>
                <property name="username" value="root"/>
                <property name="password" value="940429"/>
                <!-- 连接池参数 -->
                <property name="maximumPoolSize" value="20"/>
                <property name="minimumIdle" value="5"/>
                <property name="connectionTimeout" value="30000"/>
                <property name="idleTimeout" value="600000"/>
                <property name="maxLifetime" value="1800000"/>
            </dataSource>
        </environment>

        <environment id="prod">
            <!-- JDBC 事务管理器：commit/rollback 手动控制 -->
            <transactionManager type="JDBC"/>
            <!-- 数据源：MyBatis 自带连接池 -->
            <dataSource type="POOLED">
                <property name="driver" value="com.mysql.cj.jdbc.Driver"/>
                <property name="url" value="jdbc:mysql://localhost:3306/rbac?useSSL=false&amp;serverTimezone=Asia/Shanghai"/>
                <property name="username" value="root"/>
                <property name="password" value="940429"/>
            </dataSource>
        </environment>
    </environments>

    <!-- 注册 Mapper（resource = classpath 相对路径，即编译后 target/classes 中的位置） -->
    <mappers>
        <mapper resource="mapper/SysUserMapper.xml"/>
        <mapper resource="mapper/WeekConfigMapper.xml"/>
    </mappers>
</configuration>