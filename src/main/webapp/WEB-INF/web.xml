<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <!-- 显示名称，没有任何意义 -->
    <display-name>java-jdbc</display-name>

    <!-- ========== Spring 与 Web 容器（Tomcat）集成的入口配置 ========== -->
    <!--  声明 Spring 配置文件的位置，“存放”在 ServletContext 里，等着 Spring 的监听器来读取  -->
    <context-param>
        <param-name>contextConfigLocation</param-name>
        <param-value>classpath:spring/spring-xml.xml</param-value>
    </context-param>
    <!-- 初始化监听器要声明在最前面，保证容器先于其他 Listener/Servlet 就绪 -->

    <!-- ========== 1. Spring项目中官方给的IOC根容器初始化监听器 ========== -->
    <!-- 注册 ContextLoaderListener，实现了 ServletContextListener -->
    <!-- ContextLoaderListener.contextInitialized() → 读取上面的 contextConfigLocation → 加载该 XML →
        创建根 WebApplicationContext（Spring 容器） → 把它存入 ServletContext 中，其他组件就能拿到它 -->
    <listener>
        <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
    </listener>

    <!-- ========== 2. Spring项目中自定义的IOC根容器初始化监听器 ========== -->
    <!-- 注册 SpringContextListener，实现了 ServletContextListener -->
    <!-- SpringContextListener.contextInitialized() → 读取上面的 contextConfigLocation → 加载该 XML →
        创建根 WebApplicationContext（Spring 容器） → 把它存入 ServletContext 中，其他组件就能拿到它-->
    <!--    <listener>-->
    <!--        <listener-class>com.wyy.listener.SpringContextListener</listener-class>-->
    <!--    </listener>-->


    <!-- ========== 3. 纯mybatis/纯连接池项目中自定义的连接池初始化监听器 ========== -->
    <!-- 注册 ServletListener，实现了 ServletContextListener -->
    <!-- ServletListener.contextInitialized() → 通过 utils 工具类初始化连接池 -->
    <!--  若项目接入了Spring，则连接池的生命周期由 Spring 管理，无需手动初始化  -->
    <!--    <listener>-->
    <!--        <listener-class>com.wyy.listener.ServletListener</listener-class>-->
    <!--    </listener>-->

    <!-- ========== 2. SessionListener（会话监听：统计在线人数与登录人数） ========== -->
    <listener>
        <listener-class>com.wyy.listener.SessionListener</listener-class>
    </listener>

    <!-- ========== 3. RequestListener（请求监听：记录请求日志与 QPS 统计） ========== -->
    <listener>
        <listener-class>com.wyy.listener.RequestListener</listener-class>
    </listener>
    <!-- ========== Filter 过滤器（web.xml 声明顺序即执行顺序） ========== -->
    <!-- ========== 1. ExceptionFilter（最先执行：全局异常兜底，捕获后续 Filter 与 Servlet 的所有未处理异常） ========== -->
    <filter>
        <filter-name>exceptionFilter</filter-name>
        <filter-class>com.wyy.filter.ExceptionFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>exceptionFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ========== 2. LogFilter（第二执行：记录请求信息与耗时，finally 保证异常时日志对称） ========== -->
    <filter>
        <filter-name>logFilter</filter-name>
        <filter-class>com.wyy.filter.LogFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>logFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ========== 3. EncodingFilter（第三执行，确保后续都能拿到正确编码） ========== -->
    <filter>
        <filter-name>encodingFilter</filter-name>
        <filter-class>com.wyy.filter.EncodingFilter</filter-class>
        <!-- 给 Filter 传初始化参数，指定编码，参数都是字符串，filter中拿到后需要强转 -->
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>encodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ========== 4. AuthFilter（最后执行，鉴权通过后才进入 Servlet） ========== -->
    <filter>
        <filter-name>authFilter</filter-name>
        <filter-class>com.wyy.filter.AuthFilter</filter-class>
        <init-param>
            <param-name>loginPage</param-name>
            <param-value>/login.jsp</param-value>
        </init-param>
        <!-- /login 为登录接口，必须放行，否则登录请求会被 AuthFilter 拦截重定向，永远无法登录 -->
        <init-param>
            <param-name>excludePaths</param-name>
            <param-value>/login.jsp,/login,/css/,/js/,/images/</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ========== Servlet ========== -->
    <!-- 1. 传统项目的servlet都在这里注册 -->
    <!-- 2. Spring项目中，controller层的Servlet都在这里注册，IOC容器管理service层及dao层和第三方的servlet -->
    <!-- 3. Spring MVC项目中，DispatcherServlet 持有的IOC子容器管理controller层的Servlet，
            IOC根容器管理service层及dao层和第三方的servlet，这里一般只注册 DispatcherServlet 前端控制器，
            若是项目中存在不想让Spring框架管理的 Servlet，则也可以在这里注册，要户注册在DispatcherServlet前面 -->
    <!-- 周配置 Servlet -->
    <!--    <servlet>-->
    <!--        <servlet-name>WeekConfigServlet</servlet-name>-->
    <!--        <servlet-class>com.wyy.controllerservlet.WeekConfigServlet</servlet-class>-->
    <!--        <load-on-startup>1</load-on-startup>-->
    <!--    </servlet>-->
    <!--    <servlet-mapping>-->
    <!--        <servlet-name>WeekConfigServlet</servlet-name>-->
    <!--        <url-pattern>/getWeekConfig</url-pattern>-->
    <!--    </servlet-mapping>-->


    <!-- 用户登录 Servlet -->
    <!--    <servlet>-->
    <!--        <servlet-name>LoginServlet</servlet-name>-->
    <!--        <servlet-class>com.wyy.controllerservlet.LoginServlet</servlet-class>-->
    <!--    </servlet>-->
    <!--    <servlet-mapping>-->
    <!--        <servlet-name>LoginServlet</servlet-name>-->
    <!--        <url-pattern>/login</url-pattern>-->
    <!--    </servlet-mapping>-->

    <!-- ========== Spring MVC 前端控制器（所有动态请求的统一入口） ========== -->
    <servlet>
        <servlet-name>dispatcherServlet</servlet-name>
        <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
        <init-param>
            <param-name>contextConfigLocation</param-name>
            <param-value>classpath:spring/spring-mvc-xml.xml</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>dispatcherServlet</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

    <!-- ========== Session 超时时间（分钟） ========== -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- ========== 欢迎页面（前端入口） ========== -->
    <!-- 1. 传统项目、纯Spring项目、Spring MVC项目MVC配置tomcat容器接管静态资源的欢迎页面配置 -->
    <!-- 2. Spring MVC项目自己接管静态资源时，这里配置的欢迎页面不生效 -->
    <!--    <welcome-file-list>-->
    <!--        <welcome-file>index.jsp</welcome-file>-->
    <!--    </welcome-file-list>-->

    <!-- ========== 错误页配置：404/500/未捕获异常统一跳转友好错误页，不向用户暴露堆栈 ========== -->
    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/error.jsp</location>
    </error-page>

</web-app>